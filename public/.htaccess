# Apache configuration for the static frontend on cPanel (public_html).
# Vite copies this file into dist/ unchanged; the deploy pipeline ships
# dist/ as-is.

# cPanel's default order tries index.php before index.html — make sure
# a leftover index.php can never shadow the app.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # sitemap.xml and robots.txt are generated by the backend API, not
  # shipped in this build. The deploy pipeline replaces the marker
  # below with a redirect to the API origin (.github/workflows/ci.yml).
  # Left as a comment it does nothing, which is what local builds get.
  # @@BACKEND_SEO_REDIRECTS@@

  # React Router (BrowserRouter) fallback: any URL that is not a real
  # file or directory is handed to index.html, so /about or
  # /services/photography still load after a browser refresh.
  RewriteRule ^index\.html$ - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # A missing build asset must stay a 404. Answering it with index.html
  # would hand the browser HTML where it expects JavaScript or CSS.
  RewriteCond %{REQUEST_URI} !^/(assets|video)/
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"

  # index.html names the current hashed bundles, so it must be
  # revalidated on every visit — otherwise a browser can keep asking
  # for files a newer deploy has already removed.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Everything Vite emits under /assets/ has a content hash in its
  # name: a changed file is a new URL, so these can be cached for good.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
