# Port the Express server listens on.
PORT=4001

# Node environment: development | production | test
NODE_ENV=development

# Comma-separated list of frontend origin(s) allowed via CORS.
# The Vite dev server defaults to http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB connection string. Required — the server will not start
# without it. Never commit a real value here; set it in backend/.env only.
MONGODB_URI=

# Secret used to sign admin session tokens (JWT). Required — the server
# will not start without it. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit a real value here; set it in backend/.env only.
JWT_SECRET=

# How long an admin session stays valid before requiring login again.
JWT_EXPIRES_IN=8h

# The public website's own origin — used to build absolute canonical
# and sitemap.xml URLs (Phase 9). Must be an origin only (scheme +
# host + port), no path — never .../api, never this backend's own
# host:port. Not a secret.
# Optional in development (falls back to the first FRONTEND_ORIGIN
# above); REQUIRED when NODE_ENV=production — the server refuses to
# start in production without it, rather than guessing wrong and
# silently producing bad SEO URLs.
PUBLIC_ORIGIN=http://localhost:5173

# How often the blog scheduler checks for due scheduled posts, in
# milliseconds (Phase 15). Must be a whole number between 1000 (1s)
# and 3600000 (1h) — the server refuses to start outside that range.
# Optional — defaults to 60000 (one minute) when unset.
SCHEDULER_INTERVAL_MS=60000
