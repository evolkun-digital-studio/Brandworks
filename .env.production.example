# BrandWorks — production environment template (Next.js 16 standalone).
#
# PLACEHOLDERS ONLY. Never commit real values, and never commit a file named
# .env.production. On the server the real file lives OUTSIDE every release:
#
#   /home/brandworks/apps/brandworks-next/shared/production.env   (chmod 600)
#
# and is loaded by systemd (EnvironmentFile=). Releases never contain .env
# files: scripts/build-release.mjs deletes any it finds and fails the release
# if a configured secret value turns up in the bundle.
#
# Two kinds of variable:
#   [runtime]     read by the server on every start; set in production.env.
#                 Changing one needs only a service restart, not a rebuild.
#   [build-time]  NEXT_PUBLIC_* values are inlined into the browser bundle by
#                 `next build`, so they must be set in the GitHub Actions build
#                 environment. Setting them in production.env alone does
#                 nothing. They are PUBLIC: anyone can read them in the bundle.
#                 Never put a secret in a NEXT_PUBLIC_* variable.
#
# Only the "required" variables are needed to boot; /api/health returns 503
# until they are valid. Everything else is optional and its feature switches
# off (or falls back) cleanly when unset.

# ---------------------------------------------------------------------------
# 1. Application
# ---------------------------------------------------------------------------
# [runtime, required]
NODE_ENV=production
# [runtime] Port and interface the standalone server binds. Bind to loopback
# only; Apache terminates HTTPS and proxies to it.
PORT=3010
HOSTNAME=127.0.0.1
# [runtime, required] Canonical public origin. Origin only: no path, query or
# trailing slash. sitemap.xml and robots.txt build every URL from it.
PUBLIC_ORIGIN=https://brandworks.me
# [runtime] Reverse proxies between the internet and Node that append to
# X-Forwarded-For (Apache = 1). Used to find the real client IP for rate
# limiting. 0 = reached directly (forwarding headers ignored).
TRUSTED_PROXY_HOPS=1
# [runtime] Hours after which a stale publish-due job is reported (default 36).
PUBLISH_DUE_HEALTH_MAX_AGE_HOURS=36

# ---------------------------------------------------------------------------
# 2. MongoDB
# ---------------------------------------------------------------------------
# [runtime, required] Blogs, news, admin users, media library, questionnaire.
MONGODB_URI=mongodb://brandworks_app:CHANGE_ME@127.0.0.1:27017/brandworks?authSource=brandworks
# [runtime] How long a request waits for MongoDB before failing (default 10000).
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# 3. Admin authentication
# ---------------------------------------------------------------------------
# [runtime, required] At least 32 random characters in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it signs every admin out.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_OF_AT_LEAST_32_CHARACTERS
# [runtime] Session length (jsonwebtoken format). The session cookie itself
# lasts 8h, so values above 8h have no effect.
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------------------------
# 4. Media storage
# ---------------------------------------------------------------------------
# [runtime] r2 (default) | s3 | cloudinary | cloudflare-images | local.
# Production should use r2: `local` writes inside the release directory and is
# lost on the next deploy.
STORAGE_PROVIDER=r2
# [runtime] Cloudflare R2 (STORAGE_PROVIDER=r2).
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=brandworks-media
# [runtime] Optional private bucket for original uploads.
R2_ORIGINALS_BUCKET=
# [runtime AND build-time] Public bucket URL. Also read by next.config.ts at
# BUILD time to allow next/image to load from it, so set it in CI as well.
R2_PUBLIC_URL=https://media.example.com
# [runtime] true keeps each original upload in the private bucket above.
MEDIA_KEEP_ORIGINALS=false
#
# Alternatives (only for the provider selected above):
# S3_REGION= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY= S3_BUCKET= S3_PUBLIC_URL=
# S3_ENDPOINT= S3_ORIGINALS_BUCKET=
# CLOUDINARY_CLOUD_NAME= CLOUDINARY_API_KEY= CLOUDINARY_API_SECRET=
# CF_IMAGES_ACCOUNT_ID= CF_IMAGES_API_TOKEN= CF_IMAGES_DELIVERY_HASH= CF_IMAGES_VARIANT=
# LOCAL_MEDIA_DIR=   (development only)

# ---------------------------------------------------------------------------
# 5. AI providers (questionnaire assistant)
# ---------------------------------------------------------------------------
# [runtime] Optional. Without a key the questionnaire still works with its
# built-in non-AI replies. Set AI_PROVIDER only when both keys are present.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_PROVIDER=
# [runtime] Per-client AI "react" calls per window (default 6).
QUESTIONNAIRE_REACT_LIMIT=

# ---------------------------------------------------------------------------
# 6. Website audit / site-scan integrations
# ---------------------------------------------------------------------------
# [runtime] All optional; each collector is skipped when unconfigured.
GOOGLE_PSI_API_KEY=
SEO_DATA_PROVIDER=
MOZ_API_TOKEN=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SITE_SCAN_TRAFFIC=false
SITE_SCAN_DAILY_LIMIT=
SITE_SCAN_MAX_PAGES=
SITE_SCAN_PAGES_BUDGET_MS=
# [runtime] Admin SEO dashboard (Google Analytics 4 / Search Console reports).
# Service-account JSON on ONE line.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=https://brandworks.me/
GSC_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# 7. Analytics and tracking — PUBLIC identifiers, [build-time]
# ---------------------------------------------------------------------------
# Inlined into the browser bundle: set these in the GitHub Actions build
# environment. Each is optional; an empty value disables that provider.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_CONTAINER_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
# Other public build-time settings.
NEXT_PUBLIC_MEDIA_BASE_URL=
NEXT_PUBLIC_EVOLKUN_URL=
# Do NOT set NEXT_PUBLIC_API_BASE_URL or NEXT_PUBLIC_APP_RUNTIME in production:
# they exist only for the legacy Vite build. Next serves the API same-origin.
