# BrandWorks — production environment template (Next.js 16, standalone)
#
# A TEMPLATE ONLY. Never commit real values. On the server, put the filled-in
# copy OUTSIDE the release folder (e.g. /home/<account>/brandworks/shared/.env.production),
# readable only by the app's user (chmod 600), and load it into the Node
# process. Full variable documentation: .env.example.
#
# ===================================================================
# 1. BUILD TIME — must be in the environment when `npm run build` runs
# ===================================================================
# NEXT_PUBLIC_* values are inlined into the browser bundle by `next build`;
# setting them only on the server afterwards has NO effect. Public values only.
NEXT_PUBLIC_MEDIA_BASE_URL=
NEXT_PUBLIC_EVOLKUN_URL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_GTM_CONTAINER_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
# Also read by next.config.ts (images.remotePatterns) at build time. Not a
# secret: it is the bucket's public URL. Repeat it in the runtime env below.
R2_PUBLIC_URL=

# ===================================================================
# 2. RUNTIME — server-only, loaded by the Node process (server.js)
# ===================================================================
# Standalone server binding. Put Apache/Passenger/a proxy in front; keep
# HOSTNAME on loopback unless the proxy is on another host.
PORT=3000
HOSTNAME=127.0.0.1

# Required
PUBLIC_ORIGIN=https://brandworks.me
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Media Manager storage (R2). Credentials are secrets.
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_ORIGINALS_BUCKET=
MEDIA_KEEP_ORIGINALS=false

# Project planner AI (optional; set ONE provider key)
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_PROVIDER=
QUESTIONNAIRE_REACT_LIMIT=6

# Website quick-look (optional)
GOOGLE_PSI_API_KEY=
SEO_DATA_PROVIDER=
MOZ_API_TOKEN=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SITE_SCAN_TRAFFIC=false
SITE_SCAN_DAILY_LIMIT=100
SITE_SCAN_MAX_PAGES=5
SITE_SCAN_PAGES_BUDGET_MS=35000

# Admin SEO reports (optional; service-account JSON is a secret)
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=
GSC_SERVICE_ACCOUNT_JSON=

# Scheduler health threshold for /api/health
PUBLISH_DUE_HEALTH_MAX_AGE_HOURS=36
