# BrandWorks — environment variables (Next.js 16)
#
# Copy to .env.local for development. Never commit a filled-in copy: every
# .env* file except the *.example templates is gitignored.
# Production values: see .env.production.example.
#
# Two kinds of variable:
#
#   NEXT_PUBLIC_*  Public. Next.js inlines these into the JavaScript bundle at
#                  `next build`, so they must be set BEFORE building, and
#                  changing one needs a rebuild. Anyone can read them in the
#                  browser: only public identifiers and URLs belong here, never
#                  a key, token, password or connection string.
#   everything     Server-only. Read at runtime by the Node server, the API
#   else           routes and the CLI jobs (src/server/jobs). They never reach
#                  the browser.
#
# The legacy Vite runtime (npm run dev:vite) still reads VITE_* names and maps
# them onto the NEXT_PUBLIC_* ones in vite.config.ts. The Next.js app ignores
# VITE_* entirely.

# --- Server: core (required in production) ---
# Canonical public origin, e.g. https://brandworks.me. Origin only: no path,
# query string or trailing slash. /sitemap.xml and /robots.txt build every
# absolute URL from it and return 500 without it in production; /api/health
# reports 503 ("publicOrigin": "missing-or-invalid") until it is set.
PUBLIC_ORIGIN=http://localhost:3000
# Optional development fallback used only when PUBLIC_ORIGIN is unset
# (first entry of a comma-separated list). Ignored in production.
FRONTEND_ORIGIN=
# MongoDB connection string (blogs, news, admin, questionnaire, site scans).
# /api/health returns 503 with "mongodb": "disconnected" when unreachable.
MONGODB_URI=
# Signs admin session tokens (HS256). Long random value, e.g.
# `openssl rand -base64 48`. At least 32 characters in production: a shorter
# value disables admin login and /api/health reports
# "adminAuth": "missing-or-weak-secret". Rotating it signs every admin out.
JWT_SECRET=
# Admin session lifetime (jsonwebtoken format). Default 8h.
JWT_EXPIRES_IN=8h
# Hours since the last successful publish-due job run before /api/health
# reports the scheduler as stale. Default 36.
PUBLISH_DUE_HEALTH_MAX_AGE_HOURS=36
# How long MongoDB calls wait to reach a server before failing, in ms
# (1000–60000). Default 10000; the driver's own 30s default would hang pages.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=

# --- Server: client IP behind a reverse proxy (rate limiting) ---
# Number of trusted proxies in front of the app that APPEND the client address
# to X-Forwarded-For (Apache mod_proxy_http does, by default). Empty or 0:
# forwarding headers are ignored and all visitors share one rate-limit bucket.
# Set it ONLY after confirming the proxy setup (docs/PRODUCTION_DEPLOYMENT.md,
# "Client IP behind the proxy"): a wrong value lets visitors forge their IP.
# Leave empty for local development.
TRUSTED_PROXY_HOPS=

# --- Public: site configuration (NEXT_PUBLIC_*, build time) ---
# Official Evolkun website (src/config/evolkun.ts), linked from the
# Technology page. Absolute https:// URL. Leave empty until confirmed —
# the "Visit Evolkun" links render as plain text without it.
NEXT_PUBLIC_EVOLKUN_URL=
# Public R2 folder for the site's built-in photography/video
# (src/lib/media.ts). Leave empty to use the default
# https://pub-4a67635800e64547a1a4fd524f7a2783.r2.dev/Photography
NEXT_PUBLIC_MEDIA_BASE_URL=

# --- Public: analytics / measurement (NEXT_PUBLIC_*, build time) ---
# Every value is optional and independent — leave any of them empty to turn
# that provider off; the site works the same either way. All load only after
# the visitor consents (src/analytics). Public identifiers, not secrets.

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Ignored if
# NEXT_PUBLIC_GTM_CONTAINER_ID is also set — GTM then owns GA4 delivery, so
# GA4 is never loaded twice (src/analytics/config.ts).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Microsoft Clarity project ID.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Google Tag Manager container ID (e.g. GTM-XXXXXXX). When set, configure GA4
# forwarding inside the GTM container, not via NEXT_PUBLIC_GA_MEASUREMENT_ID.
NEXT_PUBLIC_GTM_CONTAINER_ID=
# Meta (Facebook) Pixel ID. Only set it for a real advertising requirement.
NEXT_PUBLIC_META_PIXEL_ID=
# Google Search Console HTML-tag verification token (the `content` value,
# NOT an API key). Emits <meta name="google-site-verification"> on public
# pages; verification itself is still completed in Search Console.
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Server: admin SEO reports (optional) ---
# Live GA4 / Search Console reports in /admin/seo. Each report needs both of
# its values. The *_SERVICE_ACCOUNT_JSON values are Google service-account
# credentials (the whole JSON on one line) — secrets, server-only.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=
GSC_SERVICE_ACCOUNT_JSON=

# --- Website project planner (/start-project) ---
# Server-only. Powers the questionnaire's AI moments (personal greeting,
# USP reply, "help me choose" suggestion, and the plan summary). Set ONE
# provider key; leave both empty and the planner still works with written
# fallback copy. NEVER prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional model override; defaults to gpt-4.1-mini.
OPENAI_MODEL=
ANTHROPIC_API_KEY=
# Optional model override; defaults to claude-haiku-5-5.
ANTHROPIC_MODEL=
# Only needed when both keys are set: openai | anthropic.
AI_PROVIDER=
# Live AI reactions to key answers, per visitor (IP) per 30 minutes. Default 6.
QUESTIONNAIRE_REACT_LIMIT=6
# Submissions are stored in MongoDB (MONGODB_URI) in the
# `project_questionnaires` collection.

# --- Website quick-look (/start-project URL steps) ---
# Server-only, like everything above. NEVER prefix with NEXT_PUBLIC_.
# Scans are cached per domain for 7 days in the `site_scans` collection.
# Optional: raises the free Google PageSpeed Insights quota.
GOOGLE_PSI_API_KEY=
# Paid link-authority data: moz | dataforseo | empty to skip.
SEO_DATA_PROVIDER=
# Moz API token (sent as the x-moz-token header). Used when SEO_DATA_PROVIDER=moz.
MOZ_API_TOKEN=
# DataForSEO API login/password (HTTP Basic). Used when SEO_DATA_PROVIDER=dataforseo.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# true = also fetch estimated organic traffic (DataForSEO Labs, India). Paid; needs dataforseo.
SITE_SCAN_TRAFFIC=false
# New scans per day (UTC) that may use the paid sources; above it only free checks run.
SITE_SCAN_DAILY_LIMIT=100
# Key pages (About, Services, Contact...) the quick-look crawls besides the homepage. Free; default 5, hard ceiling 10.
SITE_SCAN_MAX_PAGES=5
# Overall time budget for the key-pages crawl, in ms. Default 35000, hard ceiling 45000. Link checks run last and are dropped first.
SITE_SCAN_PAGES_BUDGET_MS=35000

# --- Media Manager (/admin/media) ---
# Server-only. Website images uploaded in the admin are converted to WebP
# and stored here. NEVER prefix any of these with NEXT_PUBLIC_.
#
# Where files go: r2 (default) | s3 | cloudinary | cloudflare-images | local.
# Leave empty to use R2. In development, if the R2 values below are empty,
# files are written to LOCAL_MEDIA_DIR instead so the admin still works.
STORAGE_PROVIDER=

# Cloudflare R2 (STORAGE_PROVIDER=r2). Create an R2 API token with
# "Object Read & Write" on the bucket. R2_PUBLIC_URL is the bucket's public
# URL (r2.dev or a custom domain), origin plus optional path, no trailing
# slash. next.config.ts also adds it to images.remotePatterns, so it must be
# set at BUILD time as well as at runtime.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Optional: a separate PRIVATE bucket for the untouched original uploads.
# Originals are never put in the public bucket. Used only when
# MEDIA_KEEP_ORIGINALS=true.
R2_ORIGINALS_BUCKET=

# Amazon S3 or any S3-compatible service (STORAGE_PROVIDER=s3).
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL=
# Optional, for S3-compatible services other than AWS.
S3_ENDPOINT=
S3_ORIGINALS_BUCKET=

# Cloudinary (STORAGE_PROVIDER=cloudinary).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare Images (STORAGE_PROVIDER=cloudflare-images). The delivery
# hash is the part after imagedelivery.net/ in an image URL.
CF_IMAGES_ACCOUNT_ID=
CF_IMAGES_API_TOKEN=
CF_IMAGES_DELIVERY_HASH=
# Delivery variant name; defaults to "public".
CF_IMAGES_VARIANT=

# Local disk (STORAGE_PROVIDER=local, development only), served from
# /api/media-files. Defaults to .media-storage in the app folder.
LOCAL_MEDIA_DIR=

# true keeps each original upload in the private bucket/folder above.
MEDIA_KEEP_ORIGINALS=false

# --- Tooling (optional) ---
# `ANALYZE=true npm run build` writes bundle-analyzer reports to .next/analyze.
ANALYZE=
# Base URL that scripts/verify-services.mjs checks (defaults to a local server).
SERVICES_BASE_URL=
