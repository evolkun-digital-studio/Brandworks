# Base URL of the backend API (src/config/api.ts) — origin only, no
# trailing /api. Not a secret — just config.
#
# Development: defaults to http://localhost:4001 if unset.
# Production: must be the real https:// API origin, e.g.
# https://api.example.com. It is baked into the bundle at build time,
# so the deploy pipeline supplies it from the VITE_API_URL GitHub
# secret — no .env file is used for production builds. A production
# build never falls back to localhost.
#
# Never put server-side secrets (JWT_SECRET, MONGODB_URI, etc.) in a
# VITE_ variable — anything prefixed VITE_ is bundled into the public
# client build and visible to anyone.
VITE_API_BASE_URL=http://localhost:4001

# Official Evolkun website (src/config/evolkun.ts), linked from the
# Technology page. Absolute https:// URL. Leave empty until confirmed —
# the "Visit Evolkun" links render as plain text without it.
VITE_EVOLKUN_URL=

# Public R2 media folder. Paste uploaded filenames into src/media.ts.
VITE_MEDIA_BASE_URL=https://pub-4a67635800e64547a1a4fd524f7a2783.r2.dev/Photography

# --- Analytics / measurement (Phase 12) ---
# Every value below is optional and independent — leave any of them
# empty/unset to disable that provider entirely; the site works
# identically either way. These are public identifiers, not secrets
# (same VITE_ convention as above), but never put a real API key,
# OAuth secret, or credential in a VITE_ variable regardless — anything
# prefixed VITE_ is bundled into the public client build.

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Ignored
# entirely if VITE_GTM_CONTAINER_ID below is also set — GTM owns GA4
# delivery in that case, so GA4 is never loaded twice (see
# src/analytics/config.ts).
VITE_GA_MEASUREMENT_ID=

# Microsoft Clarity project ID.
VITE_CLARITY_PROJECT_ID=

# Google Tag Manager container ID (e.g. GTM-XXXXXXX). When set, this
# becomes the sole mechanism responsible for GA4 delivery — configure
# GA4 forwarding inside the GTM container itself, not via
# VITE_GA_MEASUREMENT_ID.
VITE_GTM_CONTAINER_ID=

# Meta (Facebook) Pixel ID. Optional — BRANDWORKS has no assumed need
# for this; only set it if a real advertising/measurement requirement
# exists.
VITE_META_PIXEL_ID=

# Google Search Console ownership-verification token (the `content`
# value from the HTML-tag verification method — NOT an API key or
# OAuth credential). When set, emits
# <meta name="google-site-verification" content="..."> on every
# public page. Setting this alone does NOT verify ownership — you
# still complete verification in Google Search Console itself.
VITE_GSC_VERIFICATION=

# --- Website project planner (/start-project) ---
# Server-only. Powers the questionnaire's AI moments (personal greeting,
# USP reply, "help me choose" suggestion, and the plan summary). Set ONE
# provider key; leave both empty and the planner still works with written
# fallback copy. NEVER prefix these with VITE_ or NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional model override; defaults to gpt-4.1-mini.
OPENAI_MODEL=
ANTHROPIC_API_KEY=
# Optional model override; defaults to claude-haiku-5-5.
ANTHROPIC_MODEL=
# Only needed when both keys are set: openai | anthropic.
AI_PROVIDER=
# Live AI reactions to key answers, per visitor (IP) per 30 minutes. Default 6.
QUESTIONNAIRE_REACT_LIMIT=6
# Submissions are stored in MongoDB (MONGODB_URI) in the
# `project_questionnaires` collection.

# --- Website quick-look (/start-project URL steps) ---
# Server-only, like everything above. NEVER prefix with VITE_ or NEXT_PUBLIC_.
# Scans are cached per domain for 7 days in the `site_scans` collection.
# Optional: raises the free Google PageSpeed Insights quota.
GOOGLE_PSI_API_KEY=
# Paid link-authority data: moz | dataforseo | empty to skip.
SEO_DATA_PROVIDER=
# Moz API token (sent as the x-moz-token header). Used when SEO_DATA_PROVIDER=moz.
MOZ_API_TOKEN=
# DataForSEO API login/password (HTTP Basic). Used when SEO_DATA_PROVIDER=dataforseo.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# true = also fetch estimated organic traffic (DataForSEO Labs, India). Paid; needs dataforseo.
SITE_SCAN_TRAFFIC=false
# New scans per day (UTC) that may use the paid sources; above it only free checks run.
SITE_SCAN_DAILY_LIMIT=100
# Key pages (About, Services, Contact...) the quick-look crawls besides the homepage. Free; default 5, hard ceiling 10.
SITE_SCAN_MAX_PAGES=5
